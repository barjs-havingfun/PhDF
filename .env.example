# Copy to `.env` and adjust. `.env` is git-ignored and read on startup (source checkouts only;
# real environment variables take precedence).

# 1 = load the Vite dev server with hot reload and devtools (run `npm --prefix frontend run dev`)
PHDF_DEV=0

# Vite dev server URL used when PHDF_DEV=1
PHDF_DEV_URL=http://localhost:5173

# Where the database and webview data live. Empty = per-user default
# (Windows: %APPDATA%\PhDF, macOS: ~/Library/Application Support/PhDF, Linux: ~/.local/share/phdf)
PHDF_DATA_DIR=
